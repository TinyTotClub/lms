# Copy to .env (gitignored) and fill in. NEVER commit real project values.

# Firebase project whose ID tokens the bridge accepts (aud/iss).
# Leave empty to keep the Firebase bridge disabled.
FIREBASE_PROJECT_ID=

# Dev only: accept unsigned tokens from the Firebase Auth emulator.
# e.g. host.docker.internal:9099
FIREBASE_AUTH_EMULATOR_HOST=

# Android/iOS package id served by mobile_auth.app_status
MOBILE_PACKAGE_NAME=com.example.lmsapp

# Host ports (defaults avoid clashing with Supabase kong on 8000, Open WebUI on 8080)
# LMS_HTTP_PORT=8090
# LMS_SOCKETIO_PORT=9002

# Site basics
SITE_NAME=lms.localhost
ADMIN_PASSWORD=admin

# Paths to the sibling app checkouts (defaults assume standard layout)
# MOBILE_CONTROL_PATH=../../../frappe-mobile-control
# LMS_MOBILE_BRIDGE_PATH=../../../lms_mobile_bridge
